{
  "name": "uploadflow",
  "version": "0.1.0",
  "description": "A streaming-first secure file ingestion pipeline for Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhilash2406/uploadflow.git"
  },
  "homepage": "https://github.com/abhilash2406/uploadflow#readme",
  "bugs": {
    "url": "https://github.com/abhilash2406/uploadflow/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "uploadflow",
    "file-upload",
    "file-ingestion",
    "streaming",
    "file-security",
    "nodejs",
    "typescript",
    "file-validation",
    "upload-middleware",
    "storage-adapter"
  ],
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "file-type": "^22.3.0",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}